{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyashrathore/agent-app-benchmark/schemas/scenario-v1.schema.json",
  "title": "Agent app benchmark scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "description", "kind", "cases", "metrics", "runProfiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["app-start", "session-switch", "custom"] },
    "cases": { "type": "object" },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "unit", "statistics"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" },
          "unit": { "enum": ["ms", "percent", "MiB"] },
          "statistics": {
            "type": "array",
            "items": { "enum": ["average", "maximum", "p95"] },
            "uniqueItems": true
          }
        }
      }
    },
    "resourceMeasurement": { "type": "object" },
    "runProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoke", "publication"],
      "properties": {
        "smoke": { "type": "integer", "minimum": 1 },
        "publication": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
