{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyashrathore/agent-app-benchmark/schemas/scenario-v1.schema.json",
  "title": "Agent app benchmark scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "description", "kind", "corpusId", "cases", "metrics", "runProfiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "kind": { "enum": ["app-start", "session-switch", "custom"] },
    "corpusId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$" },
    "cases": { "type": "object", "minProperties": 1 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "unit", "betterDirection", "observer", "rawField", "statistics", "reportPlacement"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
          "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "unit": { "enum": ["ms", "percent", "MiB", "bytes"] },
          "betterDirection": { "enum": ["lower", "higher", "neutral"] },
          "observer": { "enum": ["driver-attested", "framework-observed", "framework-derived"] },
          "rawField": { "type": "string", "minLength": 1 },
          "statistics": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["average", "maximum", "p95", "trend"] } },
          "reportPlacement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resourceMeasurement": { "type": "object" },
    "runProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoke", "quick", "publication"],
      "properties": {
        "smoke": { "type": "integer", "minimum": 1 },
        "quick": { "type": "integer", "minimum": 1 },
        "publication": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
