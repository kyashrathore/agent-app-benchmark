{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyashrathore/agent-app-benchmark/schemas/workspace-fixture-v1.schema.json",
  "title": "Canonical workspace fixture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generator", "seed", "load", "directories", "files", "changedFilePaths", "openFilePaths", "manifestDigestSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generator": { "const": "agent-app-workspace-v1" },
    "seed": { "type": "string", "minLength": 1, "maxLength": 300 },
    "load": { "$ref": "#/$defs/load" },
    "directories": { "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "files": { "type": "array", "minItems": 1, "maxItems": 100000, "items": { "$ref": "#/$defs/file" } },
    "changedFilePaths": { "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "openFilePaths": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "manifestDigestSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$", "maxLength": 500 },
    "load": {
      "type": "object", "additionalProperties": false,
      "required": ["generator", "directoryCount", "sourceFileCount", "sourceFileBytes", "changedFileCount", "diffHunksPerFile", "diffLinesPerHunk", "openFileTabCount"],
      "properties": {
        "generator": { "const": "agent-app-workspace-v1" },
        "directoryCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "sourceFileCount": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "sourceFileBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "changedFileCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "diffHunksPerFile": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "diffLinesPerHunk": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "openFileTabCount": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "hunk": {
      "type": "object", "additionalProperties": false, "required": ["startLine", "lineCount"],
      "properties": {
        "startLine": { "type": "integer", "minimum": 0 },
        "lineCount": { "type": "integer", "minimum": 1 }
      }
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "byteLength", "changed", "hunks", "initialDigestSha256", "currentDigestSha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "changed": { "type": "boolean" },
        "hunks": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/hunk" } },
        "initialDigestSha256": { "$ref": "#/$defs/sha256" },
        "currentDigestSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
