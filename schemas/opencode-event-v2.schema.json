{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyashrathore/agent-app-benchmark/schemas/opencode-event-v2.schema.json",
  "title": "Pinned OpenCode EventV2 serialized completed-history subset",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "seq", "aggregateID", "data"],
  "properties": {
    "id": { "type": "string", "pattern": "^evt_" },
    "type": { "enum": ["session.created.1", "message.updated.1", "message.part.updated.1"] },
    "seq": { "type": "integer", "minimum": 0 },
    "aggregateID": { "type": "string", "pattern": "^ses" },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "session.created.1" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionID", "info"],
            "properties": {
              "sessionID": { "type": "string", "pattern": "^ses" },
              "info": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "slug", "projectID", "workspaceID", "directory", "title", "version", "time"],
                "properties": {
                  "id": { "type": "string", "pattern": "^ses" },
                  "slug": { "type": "string" },
                  "projectID": { "type": "string" },
                  "workspaceID": { "type": "string" },
                  "directory": { "type": "string" },
                  "title": { "type": "string" },
                  "version": { "type": "string" },
                  "time": { "$ref": "#/$defs/createdUpdatedTime" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "message.updated.1" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionID", "info"],
            "properties": {
              "sessionID": { "type": "string", "pattern": "^ses" },
              "info": {
                "type": "object",
                "required": ["id", "sessionID", "role", "time"],
                "properties": {
                  "id": { "type": "string", "pattern": "^msg" },
                  "sessionID": { "type": "string", "pattern": "^ses" },
                  "role": { "enum": ["user", "assistant"] },
                  "time": { "type": "object" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "message.part.updated.1" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionID", "part", "time"],
            "properties": {
              "sessionID": { "type": "string", "pattern": "^ses" },
              "part": { "$ref": "#/$defs/part" },
              "time": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "createdUpdatedTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "updated"],
      "properties": {
        "created": { "type": "integer", "minimum": 0 },
        "updated": { "type": "integer", "minimum": 0 }
      }
    },
    "partTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "partBaseProperties": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^prt" },
        "sessionID": { "type": "string", "pattern": "^ses" },
        "messageID": { "type": "string", "pattern": "^msg" }
      }
    },
    "part": {
      "oneOf": [
        { "$ref": "#/$defs/textPart" },
        { "$ref": "#/$defs/reasoningPart" },
        { "$ref": "#/$defs/toolPart" },
        { "$ref": "#/$defs/stepStartPart" },
        { "$ref": "#/$defs/stepFinishPart" },
        { "$ref": "#/$defs/patchPart" }
      ]
    },
    "textPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sessionID", "messageID", "type", "text", "time"],
      "properties": {
        "id": { "type": "string", "pattern": "^prt" },
        "sessionID": { "type": "string", "pattern": "^ses" },
        "messageID": { "type": "string", "pattern": "^msg" },
        "type": { "const": "text" },
        "text": { "type": "string" },
        "time": { "$ref": "#/$defs/partTime" }
      }
    },
    "reasoningPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sessionID", "messageID", "type", "text", "time"],
      "properties": {
        "id": { "type": "string", "pattern": "^prt" },
        "sessionID": { "type": "string", "pattern": "^ses" },
        "messageID": { "type": "string", "pattern": "^msg" },
        "type": { "const": "reasoning" },
        "text": { "type": "string" },
        "time": { "$ref": "#/$defs/partTime" }
      }
    },
    "toolPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sessionID", "messageID", "type", "callID", "tool", "state"],
      "properties": {
        "id": { "type": "string", "pattern": "^prt" },
        "sessionID": { "type": "string", "pattern": "^ses" },
        "messageID": { "type": "string", "pattern": "^msg" },
        "type": { "const": "tool" },
        "callID": { "type": "string", "pattern": "^call_" },
        "tool": { "enum": ["read", "search", "list", "shell", "apply_patch"] },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "input", "output", "title", "metadata", "time"],
          "properties": {
            "status": { "const": "completed" },
            "input": { "type": "object" },
            "output": { "type": "string" },
            "title": { "type": "string" },
            "metadata": { "type": "object" },
            "time": { "$ref": "#/$defs/partTime" }
          }
        }
      }
    },
    "stepStartPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sessionID", "messageID", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^prt" },
        "sessionID": { "type": "string", "pattern": "^ses" },
        "messageID": { "type": "string", "pattern": "^msg" },
        "type": { "const": "step-start" }
      }
    },
    "stepFinishPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sessionID", "messageID", "type", "reason", "cost", "tokens"],
      "properties": {
        "id": { "type": "string", "pattern": "^prt" },
        "sessionID": { "type": "string", "pattern": "^ses" },
        "messageID": { "type": "string", "pattern": "^msg" },
        "type": { "const": "step-finish" },
        "reason": { "const": "stop" },
        "cost": { "const": 0 },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output", "reasoning", "cache"],
          "properties": {
            "input": { "type": "number", "minimum": 0 },
            "output": { "type": "number", "minimum": 0 },
            "reasoning": { "type": "number", "minimum": 0 },
            "cache": {
              "type": "object",
              "additionalProperties": false,
              "required": ["read", "write"],
              "properties": {
                "read": { "type": "number", "minimum": 0 },
                "write": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "patchPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sessionID", "messageID", "type", "hash", "files"],
      "properties": {
        "id": { "type": "string", "pattern": "^prt" },
        "sessionID": { "type": "string", "pattern": "^ses" },
        "messageID": { "type": "string", "pattern": "^msg" },
        "type": { "const": "patch" },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "files": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "pattern": "^src/fixture-[0-9]+\\.ts$" } }
      }
    }
  }
}
