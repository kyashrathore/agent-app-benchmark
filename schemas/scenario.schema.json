{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyashrathore/agent-app-benchmark/schemas/scenario.schema.json",
  "title": "Agent app benchmark scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "kind",
    "corpusId",
    "cases",
    "metrics",
    "runProfiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "kind": {
      "enum": [
        "app-start",
        "session-switch",
        "new-thread",
        "long-thread",
        "typing-while-streaming"
      ]
    },
    "corpusId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "cases": {
      "type": "object"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "unit": {
            "enum": [
              "ms",
              "percent",
              "MiB",
              "bytes",
              "count"
            ]
          }
        }
      }
    },
    "resourceMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processScope",
        "activeSampleIntervalMs",
        "idleSampleIntervalMs",
        "settleBeforeIdleMs",
        "idleWindowMs"
      ],
      "properties": {
        "processScope": {
          "const": "application-family"
        },
        "activeSampleIntervalMs": {
          "type": "integer",
          "minimum": 50,
          "maximum": 5000
        },
        "idleSampleIntervalMs": {
          "type": "integer",
          "minimum": 50,
          "maximum": 5000
        },
        "settleBeforeIdleMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "idleWindowMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      }
    },
    "runProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "smoke",
        "quick",
        "publication"
      ],
      "properties": {
        "smoke": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "quick": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "publication": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "app-start"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "cases": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startModes"
            ],
            "properties": {
              "startModes": {
                "const": [
                  "new-application-state",
                  "initialized-application-state"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "session-switch"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "resourceMeasurement"
        ],
        "properties": {
          "cases": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workspaceRelations",
              "sessionStates",
              "nominalBytes",
              "walk"
            ],
            "properties": {
              "workspaceRelations": {
                "const": [
                  "within-workspace",
                  "across-workspaces"
                ]
              },
              "sessionStates": {
                "const": [
                  "cold",
                  "warm"
                ]
              },
              "resourceRuns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "walk": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "controlWorkspaceId",
                  "passes",
                  "sessions"
                ],
                "properties": {
                  "controlWorkspaceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "passes": {
                    "const": [
                      "cold",
                      "warm"
                    ]
                  },
                  "sessions": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "sessionId",
                        "workspaceId",
                        "nominalBytes"
                      ],
                      "properties": {
                        "sessionId": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]*$"
                        },
                        "workspaceId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "nominalBytes": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 268435456
                        }
                      }
                    }
                  }
                }
              },
              "nominalBytes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 268435456
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "new-thread"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "cases": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceSessionId",
              "profiles"
            ],
            "properties": {
              "sourceSessionId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "profiles": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "smoke",
                  "quick",
                  "publication"
                ],
                "properties": {
                  "smoke": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "samplesPerProcess"
                    ],
                    "properties": {
                      "samplesPerProcess": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      }
                    }
                  },
                  "quick": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "samplesPerProcess"
                    ],
                    "properties": {
                      "samplesPerProcess": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      }
                    }
                  },
                  "publication": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "samplesPerProcess"
                    ],
                    "properties": {
                      "samplesPerProcess": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "long-thread"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "cases": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceSessionId",
              "sessionId",
              "visits",
              "scroll"
            ],
            "properties": {
              "sourceSessionId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "sessionId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "visits": {
                "const": [
                  "cold",
                  "warm"
                ]
              },
              "scroll": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "wheelCount",
                  "deltaY",
                  "intervalMs",
                  "tailMs",
                  "longFrameMs"
                ],
                "properties": {
                  "wheelCount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200
                  },
                  "deltaY": {
                    "type": "integer",
                    "minimum": -5000,
                    "maximum": -1
                  },
                  "intervalMs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "tailMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5000
                  },
                  "longFrameMs": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "typing-while-streaming"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "cases": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prompt",
              "firstWordChars",
              "streams",
              "keys",
              "replay",
              "profiles"
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "firstWordChars": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "streams": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "startIntervalMs"
                ],
                "properties": {
                  "startIntervalMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 60000
                  }
                }
              },
              "keys": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sequence",
                  "intervalMs",
                  "jitter",
                  "seed",
                  "missAfterMs"
                ],
                "properties": {
                  "sequence": {
                    "type": "string",
                    "pattern": "^[a-z]+$",
                    "maxLength": 500
                  },
                  "intervalMs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5000
                  },
                  "jitter": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.9
                  },
                  "seed": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "missAfterMs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60000
                  }
                }
              },
              "replay": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "deltaChars",
                  "intervalMs"
                ],
                "properties": {
                  "deltaChars": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "intervalMs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                }
              },
              "profiles": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "smoke",
                  "quick",
                  "publication"
                ],
                "properties": {
                  "smoke": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "streamCount",
                      "keyCount",
                      "deltaCount"
                    ],
                    "properties": {
                      "streamCount": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20
                      },
                      "keyCount": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 500
                      },
                      "deltaCount": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000
                      }
                    }
                  },
                  "quick": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "streamCount",
                      "keyCount",
                      "deltaCount"
                    ],
                    "properties": {
                      "streamCount": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20
                      },
                      "keyCount": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 500
                      },
                      "deltaCount": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000
                      }
                    }
                  },
                  "publication": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "streamCount",
                      "keyCount",
                      "deltaCount"
                    ],
                    "properties": {
                      "streamCount": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20
                      },
                      "keyCount": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 500
                      },
                      "deltaCount": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {}
}
