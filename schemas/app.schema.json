{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyashrathore/agent-app-benchmark/schemas/app.schema.json",
  "title": "Registered benchmark application v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "repository", "driverOwnership", "guiFramework", "sourceEventFormats", "materializationModes", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "repository": { "type": "string", "pattern": "^https://" },
    "driverOwnership": { "const": "application-repository" },
    "guiFramework": { "type": "string", "minLength": 1, "maxLength": 80 },
    "sourceEventFormats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["opencode-event"] } },
    "materializationModes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["native-opencode", "translated"] } },
    "scenarios": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } }
  }
}
