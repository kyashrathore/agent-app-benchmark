{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyashrathore/agent-app-benchmark/schemas/corpus-v1.schema.json",
  "title": "Agent app benchmark procedural corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "generator", "seed", "workspaceIds", "transcriptBytes", "messageChunkBytes", "description"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$" },
    "generator": { "const": "deterministic-transcript-v1" },
    "seed": { "type": "string", "minLength": 1 },
    "workspaceIds": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "transcriptBytes": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
    "messageChunkBytes": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 1 }
  }
}
