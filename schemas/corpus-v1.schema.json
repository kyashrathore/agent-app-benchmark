{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyashrathore/agent-app-benchmark/schemas/corpus-v1.schema.json",
  "title": "OpenCode completed transcript corpus definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "generator", "seed", "sourceEventFormat", "workspaceIds", "transcriptBytes", "messageChunkBytes", "description"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$" },
    "generator": { "const": "opencode-completed-transcripts-v1" },
    "seed": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sourceEventFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceRevision", "envelope", "eventTypes"],
      "properties": {
        "id": { "const": "opencode-event-v1" },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "envelope": { "const": "EventV2.SerializedEvent" },
        "eventTypes": { "type": "array", "const": ["session.created.1", "message.updated.1", "message.part.updated.1"] }
      }
    },
    "workspaceIds": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "transcriptBytes": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
    "messageChunkBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
  }
}
