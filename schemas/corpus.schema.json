{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyashrathore/agent-app-benchmark/schemas/corpus.schema.json",
  "title": "Agent app benchmark corpus definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "sourceEventFormat",
    "workspaceIds",
    "recording",
    "sessions",
    "derivation",
    "description"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "sourceEventFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceRevision",
        "envelope",
        "eventTypes"
      ],
      "properties": {
        "id": {
          "const": "opencode-event"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "envelope": {
          "const": "EventV2.SerializedEvent"
        },
        "eventTypes": {
          "const": [
            "session.created.1",
            "message.updated.1",
            "message.part.updated.1"
          ]
        }
      }
    },
    "workspaceIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application",
        "version",
        "model",
        "project",
        "repository",
        "revision",
        "license"
      ],
      "properties": {
        "application": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "derivation": {
      "$ref": "#/$defs/derivation"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalSessionId",
        "workspaceId",
        "role",
        "cut"
      ],
      "properties": {
        "logicalSessionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 160
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "role": {
          "enum": [
            "control",
            "within-workspace-cold",
            "within-workspace-warm",
            "across-workspaces-cold",
            "across-workspaces-warm",
            "size-latency",
            "progressive-resource",
            "long-thread"
          ]
        },
        "cut": {
          "$ref": "#/$defs/cut"
        }
      }
    },
    "cut": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turns"
          ],
          "properties": {
            "turns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transcriptBytes"
          ],
          "properties": {
            "transcriptBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "messages"
          ],
          "properties": {
            "messages": {
              "type": "integer",
              "minimum": 2,
              "maximum": 60000
            }
          }
        }
      ]
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "sourceFamilies",
        "privateContentCopied"
      ],
      "properties": {
        "method": {
          "const": "redacted recorded agent session"
        },
        "sourceFamilies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "opencode",
              "claude-code",
              "codex"
            ]
          }
        },
        "privateContentCopied": {
          "type": "boolean"
        }
      }
    }
  }
}
