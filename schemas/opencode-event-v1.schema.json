{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyashrathore/agent-app-benchmark/schemas/opencode-event-v1.schema.json",
  "title": "Pinned OpenCode EventV2 serialized event subset",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "seq", "aggregateID", "data"],
  "properties": {
    "id": { "type": "string", "pattern": "^evt_" },
    "type": { "enum": ["session.created.1", "message.updated.1", "message.part.updated.1"] },
    "seq": { "type": "integer", "minimum": 0 },
    "aggregateID": { "type": "string", "pattern": "^ses" },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "session.created.1" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionID", "info"],
            "properties": {
              "sessionID": { "type": "string", "pattern": "^ses" },
              "info": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "slug", "projectID", "workspaceID", "directory", "title", "version", "time"],
                "properties": {
                  "id": { "type": "string", "pattern": "^ses" },
                  "slug": { "type": "string" },
                  "projectID": { "type": "string" },
                  "workspaceID": { "type": "string" },
                  "directory": { "type": "string" },
                  "title": { "type": "string" },
                  "version": { "type": "string" },
                  "time": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["created", "updated"],
                    "properties": { "created": { "type": "integer", "minimum": 0 }, "updated": { "type": "integer", "minimum": 0 } }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "message.updated.1" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionID", "info"],
            "properties": {
              "sessionID": { "type": "string", "pattern": "^ses" },
              "info": {
                "type": "object",
                "required": ["id", "sessionID", "role", "time"],
                "properties": {
                  "id": { "type": "string", "pattern": "^msg" },
                  "sessionID": { "type": "string", "pattern": "^ses" },
                  "role": { "enum": ["user", "assistant"] },
                  "time": { "type": "object" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "message.part.updated.1" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionID", "part", "time"],
            "properties": {
              "sessionID": { "type": "string", "pattern": "^ses" },
              "part": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "sessionID", "messageID", "type", "text", "time"],
                "properties": {
                  "id": { "type": "string", "pattern": "^prt" },
                  "sessionID": { "type": "string", "pattern": "^ses" },
                  "messageID": { "type": "string", "pattern": "^msg" },
                  "type": { "const": "text" },
                  "text": { "type": "string" },
                  "time": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["start", "end"],
                    "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 0 } }
                  }
                }
              },
              "time": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  ]
}
