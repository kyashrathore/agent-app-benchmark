{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyashrathore/agent-app-benchmark/schemas/driver-message-v1.schema.json",
  "title": "Agent app benchmark driver message v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "kind", "correlationId", "method", "params"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "kind": { "const": "request" },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "method": { "enum": ["hello", "prepare", "launch", "run-case", "shutdown"] },
        "params": { "type": "object" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "kind", "correlationId", "method", "ok"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "kind": { "const": "response" },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "method": { "enum": ["hello", "prepare", "launch", "run-case", "shutdown"] },
        "ok": { "type": "boolean" },
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        }
      }
    }
  ]
}
