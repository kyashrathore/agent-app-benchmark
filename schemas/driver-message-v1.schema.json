{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyashrathore/agent-app-benchmark/schemas/driver-message-v1.schema.json",
  "title": "Agent app benchmark NDJSON driver message v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "kind", "correlationId", "method", "params"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "kind": { "const": "request" },
        "correlationId": { "type": "string", "pattern": "^request-[0-9]+$" },
        "method": { "enum": ["hello", "prepare", "launch", "execute", "shutdown"] },
        "params": { "type": "object" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "kind", "correlationId", "method", "ok"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "kind": { "const": "response" },
        "correlationId": { "type": "string", "pattern": "^request-[0-9]+$" },
        "method": { "enum": ["hello", "prepare", "launch", "execute", "shutdown"] },
        "ok": { "type": "boolean" },
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "message": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "result": {} }, "required": ["result"], "not": { "properties": { "error": {} }, "required": ["error"] } } },
        { "if": { "properties": { "ok": { "const": false } } }, "then": { "properties": { "error": {} }, "required": ["error"], "not": { "properties": { "result": {} }, "required": ["result"] } } }
      ]
    }
  ]
}
