{
  "schemaVersion": 1,
  "id": "session-switch-v1",
  "title": "Historical session switching",
  "description": "Switch among completed historical transcripts while varying workspace relation, destination state, and logical transcript bytes.",
  "kind": "session-switch",
  "corpusId": "opencode-completed-transcripts-v1",
  "cases": {
    "workspaceRelations": ["within-workspace", "across-workspaces"],
    "sessionStates": ["cold", "warm"],
    "transcriptBytes": [1048576, 2097152, 4194304, 8388608, 16777216, 33554432]
  },
  "metrics": [
    {
      "id": "switch.duration_ms",
      "description": "Elapsed monotonic time from trusted destination activation until the requested content is correct, the first fold has no blank virtualization gap, two presentation opportunities have completed, and trusted input is accepted.",
      "unit": "ms",
      "betterDirection": "lower",
      "observer": "driver-attested",
      "rawField": "durationMs",
      "statistics": ["average", "maximum", "p95"],
      "reportPlacement": "session-switch-lane-tables"
    }
  ],
  "resourceMeasurement": {
    "processScope": "application-family",
    "activeSampleIntervalMs": 250,
    "idleSampleIntervalMs": 1000,
    "settleBeforeIdleMs": 15000,
    "idleWindowMs": 60000,
    "memoryMetrics": ["baseline_idle_average_rss_mib", "active_average_rss_mib", "active_maximum_rss_mib", "active_p95_rss_mib", "ending_idle_average_rss_mib", "retained_rss_growth_mib"],
    "cpuTrend": true,
    "memoryTrend": true
  },
  "runProfiles": {
    "smoke": 3,
    "quick": 5,
    "publication": 20
  }
}
