{
  "name": "agent-app-benchmark",
  "version": "0.1.0",
  "description": "Reproducible performance benchmarks for multi-harness coding-agent GUI applications",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agent-app-benchmark": "./bin/agent-app-benchmark.mjs"
  },
  "exports": {
    "./driver-sdk": {
      "types": "./src/driver-sdk.d.ts",
      "default": "./src/driver-sdk.mjs"
    },
    "./workspace-fixture": {
      "types": "./src/workspace-fixture.d.ts",
      "default": "./src/workspace-fixture.mjs"
    }
  },
  "scripts": {
    "test": "node --test",
    "test:resource-monitor-integration": "RESOURCE_MONITOR_BIN=./native/resource-monitor/target/release/agent-app-resource-monitor node --test tests/resource-monitor.integration.test.mjs",
    "validate": "node ./bin/agent-app-benchmark.mjs validate",
    "generate:corpus": "node ./bin/agent-app-benchmark.mjs corpus generate --corpus opencode-completed-sessions-v3 --output artifacts/corpora/opencode-completed-sessions-v3",
    "site:build": "node ./bin/agent-app-benchmark.mjs site build --comparison results/comparisons/initial-macos-arm64/comparison.json --output artifacts/sites/initial-macos-arm64",
    "lint": "node --check bin/agent-app-benchmark.mjs && find src examples scripts tests -type f \\( -name '*.mjs' -o -name '*.js' \\) -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "engines": {
    "node": ">=22"
  }
}
